# ArduRover 4.6 on esp32s3devkit: RC car (steering servo + ESC) with
# MPU9250 IMU, LDROBOT LD14 LiDAR and ZED-F9P RTK GPS
# RTK corrections from Mission Planner (NTRIP -> MAVLink over WiFi), option A.
#
# Load: Mission Planner -> Config -> Full Parameter List -> Load from file
#       -> Write Params, then reboot the board.
#
# Wiring (libraries/AP_HAL_ESP32/boards/esp32s3devkit.h):
#   steering servo signal <- GPIO11  SERVO1
#   ESC signal            <- GPIO9   SERVO3
#   receiver PPM/SBUS out -> GPIO14  RCIN
#   MPU9250 SDA / SCL     -- GPIO16 / GPIO15  I2C, address 0x68 (AD0 low)
#   BMP280 (optional)     -- same I2C bus, address 0x77
#   LD14 TX               -> GPIO41  SERIAL2 (UART2 rx)   LD14 RX unwired
#   F9P UART1 TX          -> GPIO17  SERIAL3 (UART1 rx)
#   F9P UART1 RX          <- GPIO18  SERIAL3 (UART1 tx)
#   all GNDs joined; F9P D_SEL open/high (UART mode, not SPI)
#   servo/ESC power from the ESC's BEC, never from the ESP32's 3V3 pin

# ---------------------------------------------------------------- RC car
FRAME_CLASS,1           # Rover
SERVO1_FUNCTION,26      # GroundSteering, GPIO11
SERVO1_MIN,1100
SERVO1_TRIM,1500        # adjust until the wheels point straight in Manual
SERVO1_MAX,1900
SERVO1_REVERSED,0       # 1 if steering right on the stick turns the wheels left
SERVO3_FUNCTION,70      # Throttle (ESC), GPIO9
SERVO3_MIN,1000
SERVO3_TRIM,1500        # ESC neutral; forward+reverse ESC
SERVO3_MAX,2000
SERVO3_REVERSED,0       # 1 if throttle forward drives the car backwards
MOT_PWM_TYPE,0          # normal PWM servo/ESC signal
PILOT_STEER_TYPE,0      # default steering response

# Receiver: PPM or SBUS on GPIO14, protocol detected automatically.
# Channel 1 steering, channel 3 throttle, channel 8 flight mode switch.
RCMAP_ROLL,1
RCMAP_THROTTLE,3
MODE_CH,8
MODE1,0                 # Manual
MODE4,10                # Auto
MODE6,11                # RTL

# Failsafes (README "Set up" step 3). Set the receiver's own failsafe so
# channel 3 drops below FS_THR_VALUE when the transmitter is off.
FS_THR_ENABLE,1         # RC signal lost
FS_GCS_ENABLE,2         # WiFi/GCS link lost, except in Auto (a patrol carries on);
                        # this also stops the car when the phone/PC stick or a
                        # LiDAR behaviour was driving it and the link drops
FS_ACTION,2             # Hold
FS_TIMEOUT,1.5          # s

# Starting points, tune after the first drives (Rover tuning guide)
CRUISE_SPEED,2          # m/s
CRUISE_THROTTLE,40      # % throttle that gives CRUISE_SPEED

# ---------------------------------------------------------------- LD14 LiDAR
SERIAL2_PROTOCOL,11     # Lidar360
SERIAL2_BAUD,115        # this unit runs the LD14 profile at 115200; a true LD14P is 230
PRX1_TYPE,19            # LD14 (LD06 parser + ranging-centre angle correction)
PRX1_ORIENT,0           # 0 = right side up, 1 = upside down
PRX1_YAW_CORR,0         # deg; set so an object straight ahead reads 0 in the proximity view
PRX1_MIN,0.05           # m; ignore returns from the robot's own chassis
PRX1_MAX,8              # m; LD14 rated range

# ---------------------------------------------------------------- ZED-F9P GPS
SERIAL3_PROTOCOL,5      # GPS (board default, set explicitly)
SERIAL3_BAUD,230        # ArduPilot autobauds the F9P, then switches it to this
GPS1_TYPE,2             # u-blox
GPS_AUTO_CONFIG,1       # ArduPilot sets the F9P's UBX messages and rates over SERIAL3
GPS1_RATE_MS,200        # 5 Hz; F9P can do 100 (10 Hz) if wanted
GPS1_GNSS_MODE,0        # receiver default constellations (F9P: GPS+GLO+GAL+BDS)
GPS_INJECT_TO,127       # pass RTCM from Mission Planner to all GPSes (the only one here)

# ---------------------------------------------------------------- MAVLink link
# SERIAL1 is the WiFi link (HAL_ESP32_WIFI): Mission Planner connects over it,
# and the NTRIP corrections arrive as GPS_RTCM_DATA on the same link.
SERIAL1_PROTOCOL,2      # MAVLink2

# ---------------------------------------------------------------- avoidance
# Use the LiDAR for Rover's obstacle avoidance once PRX1_YAW_CORR is verified,
# or the robot will avoid obstacles that are not where it thinks.
# README "Set up" step 8 explains the four strategies.
# Simple avoidance: stop before obstacles (Acro, Steering, Loiter...).
# Rover's default is 3 (fence + proximity), so it is turned off here until then.
AVOID_ENABLE,0          # set 3 (fence + proximity) once PRX1_YAW_CORR is right
#AVOID_MARGIN,0.5        # m kept from obstacles
# Path planning in Auto/Guided/RTL (reboot after setting OA_TYPE):
# 1 BendyRuler (LiDAR + fences), 2 Dijkstra's (fences only), 3 Dijkstra's with BendyRuler
#OA_TYPE,1
#OA_MARGIN_MAX,2         # m kept from obstacles and fences; keep it above WP_RADIUS
#OA_BR_LOOKAHEAD,5       # m probed ahead, under the LD14's 8 m range
#OA_DB_DIST_MAX,8        # m, the LD14's range
